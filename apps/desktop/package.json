  "type": "module",
  "scripts": {
    "dev": "vite",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build --config src-tauri/tauri.bundle.conf.json",
    "host": "node scripts/host.mjs",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
