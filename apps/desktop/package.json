    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "playwright": "^1.63.0",
    "selenium-webdriver": "^4.50.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.3"
  }
}
