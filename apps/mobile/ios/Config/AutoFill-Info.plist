<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The AutoFill extension: it provides passwords, chosen in its own
	     screen, and from iOS 26.2 saves what a login form submitted, where
	     the owner chooses in its screen; it registers none with the system
	     and makes no passkeys. It does not declare ProvidesOneTimeCodes:
	     iOS offers a provider's codes only for the sites it registered. -->
	<key>NSExtension</key>
	<dict>
		<key>NSExtensionAttributes</key>
		<dict>
			<key>ASCredentialProviderExtensionCapabilities</key>
			<dict>
				<key>ProvidesPasswords</key>
				<true/>
				<key>SupportsSavePasswordCredentials</key>
				<true/>
			</dict>
		</dict>
		<key>NSExtensionPointIdentifier</key>
		<string>com.apple.authentication-services-credential-provider-ui</string>
		<key>NSExtensionPrincipalClass</key>
		<string>$(PRODUCT_MODULE_NAME).CredentialProviderViewController</string>
	</dict>
</dict>
</plist>
