<?xml version="1.0" encoding="utf-8"?>
<!-- OtherFieldService: no event types, so Android sends it none; it reads
     the window in front only when a login was chosen. Not a tool for people
     with disabilities, as Android 12 and later ask. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagReportViewIds"
    android:canRetrieveWindowContent="true"
    android:description="@string/other_field_description"
    android:isAccessibilityTool="false"
    tools:targetApi="31" />
