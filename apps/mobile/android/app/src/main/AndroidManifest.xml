<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Unlocking with a fingerprint or the face, if the owner turns it on. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- Hide non-system overlay windows above vault, autofill, and passkey screens (API 31+). -->
    <uses-permission android:name="android.permission.HIDE_OVERLAY_WINDOWS" />
    <!-- Only to scan the QR code of an invitation, asked for when the owner
         chooses to; a phone without a camera pastes the invitation. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <!-- The apps a person can open, so that the fill and save screens can
         tell which app asks by its signing certificate: Android hides other
         apps from this one otherwise. An app without a launcher entry stays
         hidden, and is filled and saved nothing. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <!-- No backup: the vault, the device's keys, and the password kept for
         biometric unlock stay on this phone. A copy elsewhere would be a
         second device under this one's identity. -->
    <application
        android:name=".VaultApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/no_extraction"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.Material.NoActionBar">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Filling logins into other apps and pages, once the owner picks
             this app as the phone's autofill service, and saving what their
             forms submit. It offers "unlock to fill", or while the vault is
             unlocked the logins a fill would offer, and a save; the fill and
             save screens do the rest. -->
        <service
            android:name=".autofill.VaultAutofillService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_AUTOFILL_SERVICE">
            <intent-filter>
                <action android:name="android.service.autofill.AutofillService" />
            </intent-filter>
            <meta-data
                android:name="android.autofill"
                android:resource="@xml/autofill_service" />
        </service>

        <!-- Off until the owner turns it on in Android's accessibility
             settings: the other field of a login chosen for a page that told
             autofill of one field only. It asks for no events and reads a
             window only for a few seconds after a login is chosen. -->
        <service
            android:name=".autofill.OtherFieldService"
            android:exported="true"
            android:label="@string/other_field_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/other_field_service" />
        </service>

        <!-- Opened by the system over the app that asks; a task of its own,
             so the vault's own screens stay where they were. Its window is
             marked translucent, so the app beneath is paused, not stopped
             (see FillOver). -->
        <activity
            android:name=".autofill.FillActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:taskAffinity=""
            android:theme="@style/FillOver"
            android:windowSoftInputMode="adjustResize" />
        <!-- As FillActivity, for a password made at a sign-up. -->
        <activity
            android:name=".autofill.GenerateActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:taskAffinity=""
            android:theme="@style/FillOver"
            android:windowSoftInputMode="adjustResize" />
        <!-- As FillActivity, for a card form. -->
        <activity
            android:name=".autofill.CardFillActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:taskAffinity=""
            android:theme="@style/FillOver"
            android:windowSoftInputMode="adjustResize" />
        <!-- Passkeys for Android's Credential Manager (Android 14 and later),
             once the owner picks this app as the phone's service for
             passwords, passkeys and autofill. It offers "unlock", or while
             the vault is unlocked the passkeys for the site that asks, and a
             place to save a new one; PasskeyActivity does the rest. -->
        <service
            android:name=".passkey.PasskeyProviderService"
            android:enabled="@bool/provides_passkeys"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_CREDENTIAL_PROVIDER_SERVICE">
            <intent-filter>
                <action android:name="android.service.credentials.CredentialProviderService" />
            </intent-filter>
            <meta-data
                android:name="android.credentials.provider"
                android:resource="@xml/passkey_provider" />
        </service>
        <!-- As FillActivity, for a passkey. -->
        <activity
            android:name=".passkey.PasskeyActivity"
            android:enabled="@bool/provides_passkeys"
            android:excludeFromRecents="true"
            android:exported="false"
            android:taskAffinity=""
            android:theme="@style/FillOver"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".autofill.SaveActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:taskAffinity=""
            android:windowSoftInputMode="adjustResize" />
    </application>
</manifest>
