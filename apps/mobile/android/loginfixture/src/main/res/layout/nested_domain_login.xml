<?xml version="1.0" encoding="utf-8"?>
<!-- Important for autofill, so that the system's view of the screen holds
     the view around the fields, with its empty domain. -->
<org.opensecretmanager.loginfixture.EmptyDomainLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:importantForAutofill="yes"
    android:orientation="vertical"
    android:padding="24dp">
    <Button
        android:id="@+id/sign_in"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Sign in" />
    <org.opensecretmanager.loginfixture.ShopField
        android:id="@+id/username"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:autofillHints="username"
        android:hint="Account"
        android:inputType="text" />
    <org.opensecretmanager.loginfixture.ShopField
        android:id="@+id/password"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:autofillHints="password"
        android:hint="Password"
        android:inputType="textPassword" />
    <TextView
        android:id="@+id/filled"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />
</org.opensecretmanager.loginfixture.EmptyDomainLayout>
