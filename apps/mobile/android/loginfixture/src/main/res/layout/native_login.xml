<?xml version="1.0" encoding="utf-8"?>
<!-- No autofill hints: the username is found as the field before the password. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:padding="24dp">
    <!-- Takes the form away, which is when the system offers to save.
         Above the fields, where neither the keyboard nor the offer to fill
         covers it. -->
    <Button
        android:id="@+id/sign_in"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Sign in" />
    <EditText
        android:id="@+id/username"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Account"
        android:inputType="text" />
    <EditText
        android:id="@+id/password"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Password"
        android:inputType="textPassword" />
    <TextView
        android:id="@+id/filled"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />
</LinearLayout>
