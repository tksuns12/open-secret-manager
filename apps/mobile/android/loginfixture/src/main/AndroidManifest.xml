<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:label="Login fixture"
        android:theme="@android:style/Theme.Material.Light">
        <!-- In the launcher, as the apps people sign in to are: the app
             under test sees only those. -->
        <activity android:name=".NativeLoginActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".CodeActivity" android:exported="true" />
        <activity android:name=".WebLoginActivity" android:exported="true" />
    </application>
</manifest>
