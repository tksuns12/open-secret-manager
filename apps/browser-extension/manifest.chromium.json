{
  "manifest_version": 3,
  "name": "Open Secret Manager",
  "version": "0.1.0",
  "description": "Fills a login or a card you choose in the Open Secret Manager app into the page you are on, and, if you turn it on, answers sites' requests for passkeys from the app.",
  "key": "",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "nativeMessaging"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    },
    "default_title": "Fill a login from Open Secret Manager"
  },
  "commands": {
    "_execute_action": {
      "description": "Fill a login from Open Secret Manager"
    }
  },
  "optional_host_permissions": [
    "https://*/*"
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
